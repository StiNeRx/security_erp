# ============================================================
# Security & Facility Management ERP — Backend Environment
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ─────────────────────────────────────────────
PROJECT_NAME="Security & Facility Management ERP"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=True                          # Set False in production

# ── JWT / Security ──────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440    # 24 hours
ALGORITHM=HS256

# ── Database ─────────────────────────────────────────────────
# Development (SQLite — no setup required):
DATABASE_URL=sqlite:///./seed.db

# Production (PostgreSQL — fill in values below and switch DATABASE_URL):
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-db-password
POSTGRES_DB=security_erp
# DATABASE_URL=postgresql://postgres:your-db-password@localhost:5432/security_erp

# ── CORS Origins ─────────────────────────────────────────────
# JSON array of allowed origins
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:8000", "http://127.0.0.1:8000"]
