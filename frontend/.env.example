# ============================================================
# Security & Facility Management ERP — Frontend Environment
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.
#
# Vite exposes only variables prefixed with VITE_ to the browser.
# ============================================================

# ── API Base URL ─────────────────────────────────────────────
# Development (local FastAPI backend)
VITE_API_BASE_URL=http://localhost:8000

# Production — uncomment and update when deploying
# VITE_API_BASE_URL=https://api.yourdomain.com

# ── App Meta ─────────────────────────────────────────────────
VITE_APP_NAME="Security ERP"
VITE_APP_VERSION="1.0.0"
