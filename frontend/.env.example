# ============================================================
# Security & Facility Management ERP — Frontend Environment
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.
#
# Vite exposes only variables prefixed with VITE_ to the browser.
# ============================================================

# ── API Base URL ─────────────────────────────────────────────
# Local Development (local FastAPI backend)
VITE_API_BASE_URL=http://localhost:8000

# Production (Vercel deployment)
# Add this variable in Vercel Project Settings -> Environment Variables
# If you don't have a live backend yet, leave it empty or unset to run in full high-fidelity Demo Mode!
# VITE_API_BASE_URL=https://security-erp-api.onrender.com

# ── App Meta ─────────────────────────────────────────────────
VITE_APP_NAME="Vanguard Ops ERP"
VITE_APP_VERSION="1.0.0"
